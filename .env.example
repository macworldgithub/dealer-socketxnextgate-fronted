# Dealer Socket Automation Environment Variables
# API Base URL for backend service
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Toggle mock API mode (set to true for standalone preview / mock data, or false to connect to live backend)
NEXT_PUBLIC_USE_MOCK_API=true

# Application branding
NEXT_PUBLIC_APP_NAME="Dealer Socket Automation"
NEXT_PUBLIC_DEALERSHIP_NAME="Dealer Socket Automation Hub"
